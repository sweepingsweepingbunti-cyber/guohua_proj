---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { RESOURCE_GROUPS } from '../data/resources';
import { SITE } from '../data/site';

const total = RESOURCE_GROUPS.reduce((n, g) => n + g.links.length, 0);
---

<BaseLayout
	title={`资源导航 · ${SITE.name}`}
	description="大模型学习路上的精选资源：原始论文、开源模型、框架工具、系统课程和活跃社区。"
>
	<PageHero
		title="资源导航"
		subtitle="不用在收藏夹里翻来翻去。论文、模型、工具、课程和社区，按类别整理在这里。"
		eyebrow={`共 ${total} 条精选`}
	>
		<nav class="jump" aria-label="资源分类跳转">
			{
				RESOURCE_GROUPS.map((group) => (
					<a class="pill" href={`#${group.id}`}>
						{group.icon} {group.title}
					</a>
				))
			}
		</nav>
	</PageHero>

	<section class="container section">
		<div class="groups">
			{
				RESOURCE_GROUPS.map((group) => (
					<section class="group" id={group.id}>
						<div class="group-head">
							<h2>
								<span aria-hidden="true">{group.icon}</span>
								{group.title}
							</h2>
							<span class="dim">{group.links.length} 条</span>
						</div>
						<p class="group-desc muted">{group.desc}</p>

						<div class="grid grid--3">
							{group.links.map((link) => (
								<a
									class="link-card card"
									href={link.href}
									target="_blank"
									rel="noopener noreferrer"
								>
									<span class="link-top">
										<strong>{link.title}</strong>
										{link.badge && <span class="pill pill--accent">{link.badge}</span>}
									</span>
									<span class="link-desc muted">{link.desc}</span>
									<span class="link-url dim">{new URL(link.href).hostname}</span>
								</a>
							))}
						</div>
					</section>
				))
			}
		</div>
	</section>
</BaseLayout>

<style>
	.jump {
		display: flex;
		gap: 8px;
		margin-top: 24px;
		flex-wrap: wrap;
	}

	.groups {
		display: flex;
		flex-direction: column;
		gap: 56px;
	}

	.group {
		/* 锚点跳转时不要被固定顶栏盖住 */
		scroll-margin-top: 88px;
	}

	.group-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
	}

	.group-head h2 {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0;
		font-size: 1.3rem;
	}

	.group-head h2::before {
		content: '';
		width: 4px;
		height: 1.1em;
		border-radius: 2px;
		background: var(--grad);
		flex: none;
	}

	.group-head .dim {
		font-size: 0.82rem;
		flex: none;
	}

	.group-desc {
		margin: 8px 0 20px;
		font-size: 0.9rem;
	}

	/* ---------- 链接卡片 ---------- */
	.link-card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		color: inherit;
		padding: 20px;
	}

	.link-card:hover {
		color: inherit;
	}

	.link-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
	}

	.link-top strong {
		font-size: 0.98rem;
		color: #fff;
		line-height: 1.45;
	}

	.link-card:hover .link-top strong {
		color: var(--accent);
	}

	.link-top .pill {
		flex: none;
		font-size: 0.7rem;
		padding: 1px 8px;
	}

	.link-desc {
		font-size: 0.86rem;
		line-height: 1.6;
	}

	.link-url {
		font-size: 0.75rem;
		font-family: var(--font-mono);
		margin-top: auto;
		padding-top: 4px;
		opacity: 0.75;
	}

	@media (max-width: 768px) {
		.groups {
			gap: 40px;
		}
	}
</style>
