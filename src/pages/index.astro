---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Subscribe from '../components/Subscribe.astro';
import { CATEGORIES, CATEGORY_SLUGS, SITE } from '../data/site';
import { RESOURCE_GROUPS } from '../data/resources';
import { PROJECTS } from '../data/projects';
import { getPublishedPosts, getSortedPaths } from '../utils/content';

const posts = await getPublishedPosts();
const paths = await getSortedPaths();

// featured 的文章排在最前面，其余按时间倒序接上
const featured = posts.filter((p) => p.data.featured);
const latest = [...featured, ...posts.filter((p) => !p.data.featured)].slice(0, 6);

const resourceCount = RESOURCE_GROUPS.reduce((n, g) => n + g.links.length, 0);

const stats = [
	{ label: '篇文章', value: posts.length },
	{ label: '条学习路线', value: paths.length },
	{ label: '个精选资源', value: resourceCount },
	{ label: '个开发项目', value: PROJECTS.length },
];

const categories = CATEGORY_SLUGS.map((slug) => ({
	slug,
	label: CATEGORIES[slug].label,
	desc: CATEGORIES[slug].desc,
	count: posts.filter((p) => p.data.category === slug).length,
})).filter((c) => c.count > 0);
---

<BaseLayout>
	<!-- ---------- Hero ---------- -->
	<section class="hero">
		<div class="glow glow--a"></div>
		<div class="glow glow--b"></div>

		<div class="container hero-inner">
			<p class="eyebrow">
				<span class="pulse" aria-hidden="true"></span>
				持续更新的学习笔记
			</p>

			<h1>
				<span class="gradient-text">{SITE.tagline}</span>
			</h1>

			<p class="sub">{SITE.subTagline}</p>

			<div class="cta">
				<a class="btn btn--primary" href="/paths">开始学习</a>
				<a class="btn btn--ghost" href="/blog">浏览全部文章</a>
			</div>

			<ul class="stats">
				{
					stats.map((s) => (
						<li>
							<strong>{s.value}</strong>
							<span>{s.label}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- ---------- 最新文章 ---------- -->
	<section class="container section">
		<div class="section-head">
			<h2>最新文章</h2>
			<a class="link-more" href="/blog">查看全部 →</a>
		</div>

		{
			latest.length > 0 ? (
				<div class="grid grid--2">
					{latest.map((post) => (
						<PostCard post={post} />
					))}
				</div>
			) : (
				<div class="empty card">
					<p>还没有文章。在 <code>src/content/blog/</code> 里新建一个 .md 文件就能发布第一篇。</p>
				</div>
			)
		}
	</section>

	<!-- ---------- 学习路线 ---------- -->
	{
		paths.length > 0 && (
			<section class="container section">
				<div class="section-head">
					<h2>学习路线</h2>
					<a class="link-more" href="/paths">全部路线 →</a>
				</div>

				<div class="grid grid--3">
					{paths.slice(0, 3).map((path) => (
						<a class="path-card card" href="/paths">
							<span class="path-icon" aria-hidden="true">
								{path.data.icon}
							</span>
							<div>
								<span class="pill pill--accent">{path.data.level}</span>
								<h3>{path.data.title}</h3>
								<p class="muted">{path.data.description}</p>
								<span class="path-count dim">{path.data.steps.length} 个阶段</span>
							</div>
						</a>
					))}
				</div>
			</section>
		)
	}

	<!-- ---------- 分类 ---------- -->
	{
		categories.length > 0 && (
			<section class="container section section--tight">
				<div class="section-head">
					<h2>按主题浏览</h2>
				</div>

				<div class="topic-grid">
					{categories.map((cat) => (
						<a class="topic card" href={`/blog/category/${cat.slug}`}>
							<span class="topic-head">
								<strong>{cat.label}</strong>
								<span class="count dim">{cat.count} 篇</span>
							</span>
							<span class="topic-desc muted">{cat.desc}</span>
						</a>
					))}
				</div>
			</section>
		)
	}

	<!-- ---------- 资源入口 ---------- -->
	<section class="container section section--tight">
		<div class="section-head">
			<h2>精选资源</h2>
			<a class="link-more" href="/resources">完整导航 →</a>
		</div>

		<div class="grid grid--3">
			{
				RESOURCE_GROUPS.map((group) => (
					<a class="res-card card" href={`/resources#${group.id}`}>
						<span class="res-icon" aria-hidden="true">
							{group.icon}
						</span>
						<h3>{group.title}</h3>
						<p class="muted">{group.desc}</p>
						<span class="count dim">{group.links.length} 条</span>
					</a>
				))
			}
		</div>
	</section>

	<!-- ---------- 开发项目 ---------- -->
	<section class="container section section--tight">
		<div class="section-head">
			<h2>开发项目</h2>
			<a class="link-more" href="/projects">全部项目 →</a>
		</div>

		<div class="grid grid--3">
			{
				PROJECTS.map((project) => (
					<a class="proj-card card" href="/projects">
						<span class="proj-icon" aria-hidden="true">
							{project.icon}
						</span>
						<h3>{project.name}</h3>
						<p class="muted">{project.tagline}</p>
					</a>
				))
			}
		</div>
	</section>

	<!-- ---------- 订阅 ---------- -->
	<section class="container section section--tight">
		<Subscribe />
	</section>
</BaseLayout>

<style>
	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		overflow: hidden;
		padding: 84px 0 64px;
		border-bottom: 1px solid var(--border);
		background: linear-gradient(180deg, var(--bg-soft) 0%, var(--bg) 100%);
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		max-width: 820px;
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin: 0 0 20px;
		padding: 5px 14px;
		border-radius: var(--radius-pill);
		border: 1px solid var(--border-hi);
		background: rgba(148, 163, 184, 0.05);
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.pulse {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 0 rgba(56, 189, 248, 0.6);
		animation: pulse 2.2s infinite;
	}

	@keyframes pulse {
		70% {
			box-shadow: 0 0 0 8px rgba(56, 189, 248, 0);
		}
		100% {
			box-shadow: 0 0 0 0 rgba(56, 189, 248, 0);
		}
	}

	h1 {
		margin: 0 0 20px;
		font-size: clamp(2rem, 5.6vw, 3.4rem);
		line-height: 1.18;
		letter-spacing: -0.03em;
	}

	.sub {
		margin: 0 0 32px;
		font-size: clamp(1rem, 1.6vw, 1.1rem);
		line-height: 1.75;
		color: var(--text-muted);
		max-width: 60ch;
	}

	.cta {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}

	/* ---------- 数据条 ---------- */
	.stats {
		display: flex;
		gap: 40px;
		list-style: none;
		margin: 48px 0 0;
		padding: 0;
		flex-wrap: wrap;
	}

	.stats li {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.stats strong {
		font-size: 1.7rem;
		line-height: 1.1;
		letter-spacing: -0.02em;
		background: var(--grad);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.stats span {
		font-size: 0.82rem;
		color: var(--text-dim);
	}

	/* ---------- 空状态 ---------- */
	.empty {
		text-align: center;
		padding: 40px;
	}

	.empty p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.92rem;
	}

	.empty code {
		font-family: var(--font-mono);
		font-size: 0.88em;
		color: var(--accent);
	}

	/* ---------- 路线卡片 ---------- */
	.path-card {
		display: flex;
		gap: 14px;
		color: inherit;
	}

	.path-card:hover {
		color: inherit;
	}

	.path-icon {
		font-size: 1.6rem;
		line-height: 1;
		flex: none;
	}

	.path-card h3 {
		margin: 10px 0 6px;
		font-size: 1rem;
		color: #fff;
	}

	.path-card:hover h3 {
		color: var(--accent);
	}

	.path-card p {
		margin: 0 0 10px;
		font-size: 0.86rem;
		line-height: 1.6;
	}

	.path-count {
		font-size: 0.78rem;
	}

	/* ---------- 主题网格 ---------- */
	.topic-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
		gap: 14px;
	}

	.topic {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 18px;
		color: inherit;
	}

	.topic:hover {
		color: inherit;
	}

	.topic-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 10px;
	}

	.topic-head strong {
		font-size: 0.98rem;
		color: #fff;
	}

	.topic:hover .topic-head strong {
		color: var(--accent);
	}

	.topic-head .count {
		font-size: 0.76rem;
		flex: none;
	}

	.topic-desc {
		font-size: 0.82rem;
		line-height: 1.55;
	}

	/* ---------- 资源卡片 ---------- */
	.res-card {
		color: inherit;
	}

	.res-card:hover {
		color: inherit;
	}

	.res-icon {
		font-size: 1.4rem;
		line-height: 1;
		display: block;
		margin-bottom: 12px;
	}

	.res-card h3 {
		margin: 0 0 6px;
		font-size: 1rem;
		color: #fff;
	}

	.res-card:hover h3 {
		color: var(--accent);
	}

	.res-card p {
		margin: 0 0 10px;
		font-size: 0.86rem;
		line-height: 1.6;
	}

	.res-card .count {
		font-size: 0.78rem;
	}

	/* ---------- 项目卡片 ---------- */
	.proj-card {
		color: inherit;
	}

	.proj-card:hover {
		color: inherit;
	}

	.proj-icon {
		font-size: 1.4rem;
		line-height: 1;
		display: block;
		margin-bottom: 12px;
	}

	.proj-card h3 {
		margin: 0 0 6px;
		font-size: 0.95rem;
		color: #fff;
		font-family: var(--font-mono);
	}

	.proj-card:hover h3 {
		color: var(--accent);
	}

	.proj-card p {
		margin: 0;
		font-size: 0.84rem;
		line-height: 1.6;
	}

	@media (max-width: 768px) {
		.hero {
			padding: 48px 0 40px;
		}

		.stats {
			gap: 28px;
			margin-top: 34px;
		}

		.stats strong {
			font-size: 1.4rem;
		}

		.cta {
			width: 100%;
		}

		.cta .btn {
			flex: 1;
			justify-content: center;
		}
	}
</style>
