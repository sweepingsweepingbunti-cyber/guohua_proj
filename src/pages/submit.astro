---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../data/site';

/**
 * 投稿指南页。
 *
 * 站点是纯静态的，没有后端能接表单提交 —— 所以投稿入口指向 GitHub 的
 * Issue 表单，那边的机器人会把稿子落到仓库的 submissions/ 隔离区，
 * 再由人工审核、提升、发布。整条链路的说明在 submissions/README.md。
 */

const articleForm = `${SITE.repo}/issues/new?template=submit-article.yml`;
const toolForm = `${SITE.repo}/issues/new?template=submit-tool.yml`;

const steps = [
	{
		icon: '📝',
		title: '在 GitHub 上填表',
		desc: '点下面的按钮会打开一个预填好的投稿表单。需要 GitHub 账号 —— 这是为了让你能收到审核结果，也方便文章发布时署名。',
	},
	{
		icon: '📥',
		title: '自动落盘，但不上线',
		desc: '提交后机器人会把内容存进仓库的隔离区，并开一个待审核的分支。这一步不会改网站上的任何东西，你的稿子不会未经审核就出现。',
	},
	{
		icon: '👀',
		title: '人工审一遍',
		desc: '我会逐字读一遍：确认是原创、没有不适合公开的内容、没有夹带 HTML。不合适会直接在原帖回复说明，不会留什么中间状态。',
	},
	{
		icon: '🚀',
		title: '通过后发布',
		desc: '审核通过的文章进入「文章」栏目，署上你的 GitHub 用户名；工具进入「社区工具」页并链到你的仓库。发布后我会回到原帖说一声。',
	},
];

const articleRules = [
	'是原创内容，或者你确实有权转载',
	'正文用 Markdown 写，代码块请标明语言',
	'不要写内嵌 HTML —— `<script>`、`<iframe>`、`onerror=` 这类会被直接拒绝',
	'不要写 LaTeX 公式 —— 本站没装数学渲染，用代码块代替',
	'不要包含隐私信息，或你无权公开的材料',
];

const toolRules = [
	'是你自己的作品，或你确认它可以被公开推荐',
	'有一个公开可访问的仓库地址',
	'说清楚它是给谁、解决什么问题的',
	'本站只做展示，不托管、不运行、不下载执行任何第三方代码',
];
---

<BaseLayout
	title={`投稿 · ${SITE.name}`}
	description="把你的学习笔记、工程实践或 agent 工具分享出来，审核通过后会发布在本站。"
>
	<PageHero
		title="投稿"
		subtitle="这个站本来就是学习交流的地方。你踩过的坑、写顺手的工具，都欢迎拿出来 —— 内容经我人工审核后会发布在这里。"
		eyebrow="文章 / 工具，两条通道"
	>
		<div class="cta">
			<a class="btn btn--primary" href={articleForm} target="_blank" rel="noopener noreferrer">
				投稿一篇文章 →
			</a>
			<a class="btn btn--ghost" href={toolForm} target="_blank" rel="noopener noreferrer">
				提交一个工具 →
			</a>
		</div>
	</PageHero>

	<section class="container section">
		<h2 class="section-title">流程</h2>

		<div class="steps">
			{
				steps.map((step, i) => (
					<article class="step card">
						<div class="step-head">
							<span class="step-icon" aria-hidden="true">
								{step.icon}
							</span>
							<span class="step-num">第 {i + 1} 步</span>
						</div>
						<h3>{step.title}</h3>
						<p class="muted">{step.desc}</p>
					</article>
				))
			}
		</div>

		<p class="note dim">
			为什么会绕到 GitHub 去？因为本站是纯静态站，没有后端也没有数据库，服务器上没有任何进程能接收表单提交 ——
			这是它的优点（快、没有可被攻破的服务），代价就是投稿得借 GitHub 的通道。完整的技术细节写在仓库的
			<code>submissions/README.md</code> 里。
		</p>
	</section>

	<section class="container section">
		<h2 class="section-title">投稿须知</h2>

		<div class="grid grid--2">
			<article class="card rules">
				<h3>📄 文章</h3>
				<ul>
					{articleRules.map((rule) => <li>{rule}</li>)}
				</ul>
				<a class="btn btn--ghost" href={articleForm} target="_blank" rel="noopener noreferrer">
					去投稿 →
				</a>
			</article>

			<article class="card rules">
				<h3>🧰 工具</h3>
				<ul>
					{toolRules.map((rule) => <li>{rule}</li>)}
				</ul>
				<a class="btn btn--ghost" href={toolForm} target="_blank" rel="noopener noreferrer">
					去提交 →
				</a>
			</article>
		</div>

		<p class="note dim">
			已经通过的工具在 <a href="/tools">社区工具</a> 页。审核是我一个人在做，可能会慢几天，见谅。
		</p>
	</section>
</BaseLayout>

<style>
	.cta {
		display: flex;
		gap: 12px;
		margin-top: 24px;
		flex-wrap: wrap;
	}

	.section-title {
		font-size: 1.25rem;
		margin: 0 0 20px;
		color: #fff;
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 16px;
	}

	.step {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 22px 20px;
	}

	.step-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
	}

	.step-icon {
		font-size: 1.4rem;
		line-height: 1;
	}

	.step-num {
		font-size: 0.72rem;
		color: var(--text-dim);
		font-variant-numeric: tabular-nums;
	}

	.step h3 {
		margin: 0;
		font-size: 0.98rem;
		color: var(--text);
	}

	.step p {
		margin: 0;
		font-size: 0.84rem;
		line-height: 1.7;
	}

	.rules {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 24px;
	}

	.rules h3 {
		margin: 0;
		font-size: 1rem;
	}

	.rules ul {
		margin: 0;
		padding-left: 1.1em;
		display: flex;
		flex-direction: column;
		gap: 9px;
		color: var(--text-muted);
		font-size: 0.87rem;
		line-height: 1.7;
	}

	.rules code {
		font-family: var(--font-mono);
		font-size: 0.88em;
		color: var(--text-muted);
	}

	.rules .btn {
		align-self: flex-start;
		margin-top: auto;
	}

	.note {
		margin: 24px 0 0;
		font-size: 0.82rem;
		line-height: 1.75;
		max-width: 76ch;
	}

	.note code {
		font-family: var(--font-mono);
		font-size: 0.92em;
		color: var(--text-muted);
	}

	@media (max-width: 900px) {
		.steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.steps {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
