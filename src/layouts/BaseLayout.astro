---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
}

const { title, description, type, publishedTime } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead {title} {description} {type} {publishedTime} />
	</head>
	<body>
		<a class="skip-link" href="#main">跳到主要内容</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		top: -100px;
		left: 16px;
		z-index: 100;
		padding: 10px 16px;
		background: var(--bg-elev);
		border: 1px solid var(--accent);
		border-radius: var(--radius-sm);
		color: var(--text);
	}

	.skip-link:focus {
		top: 12px;
	}

	main {
		min-height: 60vh;
	}
</style>
