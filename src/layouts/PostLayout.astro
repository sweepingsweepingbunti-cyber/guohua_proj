---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Subscribe from '../components/Subscribe.astro';
import { categoryLabel, SITE } from '../data/site';
import { formatDate, readingTime, type Post } from '../utils/content';

interface Props {
	post: Post;
	headings: MarkdownHeading[];
	prev?: Post;
	next?: Post;
}

const { post, headings, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, credit } = post.data;

const minutes = readingTime(post.body);

// 目录只收 h2/h3，h4 太多会显得吵闹；少于两条就不显示侧栏
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.length >= 2;

const hasUpdate = updatedDate && updatedDate.valueOf() !== pubDate.valueOf();
---

<BaseLayout title={`${title} · ${SITE.name}`} description={description} type="article" publishedTime={pubDate}>
	<article class="post">
		<header class="post-hero">
			<div class="glow glow--a"></div>

			<div class="container post-hero-inner">
				<nav class="breadcrumb" aria-label="面包屑">
					<a href="/">首页</a>
					<span aria-hidden="true">/</span>
					<a href="/blog">文章</a>
					<span aria-hidden="true">/</span>
					<a href={`/blog/category/${category}`}>{categoryLabel(category)}</a>
				</nav>

				<h1>{title}</h1>
				<p class="lede">{description}</p>

				<div class="post-meta">
					<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
					{hasUpdate && <span class="dot" aria-hidden="true">·</span>}
					{hasUpdate && <span>更新于 {formatDate(updatedDate)}</span>}
					<span class="dot" aria-hidden="true">·</span>
					<span>{minutes} 分钟阅读</span>
					<span class="dot" aria-hidden="true">·</span>
					{/* credit 只在社区投稿的文章上有，作者自己的文章不显示 */}
					<span>{credit ? `本文由 @${credit} 投稿` : SITE.author.name}</span>
				</div>

				{
					tags.length > 0 && (
						<div class="post-tags">
							{tags.map((tag) => (
								<a class="pill" href={`/blog/tags/${tag}`}>
									#{tag}
								</a>
							))}
						</div>
					)
				}
			</div>
		</header>

		<div class="container post-body">
			<div class="prose">
				<slot />

				<Subscribe compact />
			</div>

			{
				showToc && (
					<aside class="toc" aria-label="本页目录">
						<p class="toc-title">目录</p>
						<ul>
							{toc.map((h) => (
								<li class:list={[{ sub: h.depth === 3 }]}>
									<a href={`#${h.slug}`}>{h.text}</a>
								</li>
							))}
						</ul>
					</aside>
				)
			}
		</div>

		{
			(prev || next) && (
				<nav class="container post-nav" aria-label="上下篇">
					{prev ? (
						<a class="post-nav-item card prev" href={`/blog/${prev.id}`}>
							<span class="label">← 上一篇</span>
							<strong>{prev.data.title}</strong>
						</a>
					) : (
						<span class="post-nav-item card empty" />
					)}
					{next ? (
						<a class="post-nav-item card next" href={`/blog/${next.id}`}>
							<span class="label">下一篇 →</span>
							<strong>{next.data.title}</strong>
						</a>
					) : (
						<span class="post-nav-item card empty" />
					)}
				</nav>
			)
		}

		<div class="container back-wrap">
			<a class="btn btn--ghost" href="/blog">← 返回文章列表</a>
		</div>
	</article>
</BaseLayout>

<style>
	/* --- 顶部信息区 --- */
	.post-hero {
		position: relative;
		overflow: hidden;
		padding: 52px 0 36px;
		border-bottom: 1px solid var(--border);
		background: linear-gradient(180deg, var(--bg-soft) 0%, var(--bg) 100%);
	}

	.post-hero-inner {
		position: relative;
		z-index: 1;
		max-width: 820px;
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 0.82rem;
		color: var(--text-dim);
		margin-bottom: 18px;
		flex-wrap: wrap;
	}

	.breadcrumb a {
		color: var(--text-dim);
	}

	.breadcrumb a:hover {
		color: var(--accent);
	}

	h1 {
		font-size: clamp(1.7rem, 4.2vw, 2.5rem);
		line-height: 1.3;
		letter-spacing: -0.025em;
		color: #fff;
		margin: 0 0 14px;
	}

	.lede {
		font-size: 1.02rem;
		color: var(--text-muted);
		margin: 0 0 20px;
		max-width: 66ch;
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 0.85rem;
		color: var(--text-dim);
		flex-wrap: wrap;
		font-variant-numeric: tabular-nums;
	}

	.dot {
		opacity: 0.5;
	}

	.post-tags {
		display: flex;
		gap: 8px;
		margin-top: 18px;
		flex-wrap: wrap;
	}

	/* --- 正文 + 目录双栏 --- */
	.post-body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 220px;
		gap: 56px;
		align-items: start;
		padding-top: 44px;
	}

	.prose {
		max-width: 760px;
	}

	/* --- 目录 --- */
	.toc {
		position: sticky;
		top: 90px;
		max-height: calc(100vh - 120px);
		overflow-y: auto;
		border-left: 1px solid var(--border);
		padding-left: 18px;
	}

	.toc-title {
		margin: 0 0 10px;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-dim);
		font-weight: 600;
	}

	.toc ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 7px;
	}

	.toc a {
		font-size: 0.83rem;
		line-height: 1.5;
		color: var(--text-dim);
		display: block;
		border-left: 2px solid transparent;
		margin-left: -20px;
		padding-left: 18px;
	}

	.toc a:hover {
		color: var(--accent);
		border-left-color: var(--accent);
	}

	.toc li.sub a {
		padding-left: 32px;
		font-size: 0.79rem;
	}

	/* --- 上下篇 --- */
	.post-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
		margin-top: 56px;
	}

	.post-nav-item {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 18px 20px;
	}

	.post-nav-item .label {
		font-size: 0.76rem;
		color: var(--text-dim);
	}

	.post-nav-item strong {
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--text);
		font-weight: 500;
	}

	.post-nav-item:hover strong {
		color: var(--accent);
	}

	.post-nav-item.next {
		text-align: right;
		align-items: flex-end;
	}

	.post-nav-item.empty {
		background: transparent;
		border-style: dashed;
		border-color: rgba(148, 163, 184, 0.1);
	}

	.back-wrap {
		margin-top: 28px;
	}

	@media (max-width: 1024px) {
		.post-body {
			grid-template-columns: minmax(0, 1fr);
			gap: 32px;
		}

		/* 窄屏把目录放到正文前面，作为一个可扫读的概览 */
		.toc {
			position: static;
			order: -1;
			max-height: none;
			border-left: none;
			border: 1px solid var(--border);
			border-radius: var(--radius-sm);
			padding: 16px 18px;
			background: var(--bg-soft);
		}

		.toc a {
			margin-left: 0;
			padding-left: 0;
			border-left: none;
		}

		.toc li.sub a {
			padding-left: 12px;
		}

		.toc a:hover {
			border-left: none;
		}
	}

	@media (max-width: 768px) {
		.post-hero {
			padding: 34px 0 26px;
		}

		.post-nav {
			grid-template-columns: 1fr;
		}

		.post-nav-item.next {
			text-align: left;
			align-items: flex-start;
		}

		.post-nav-item.empty {
			display: none;
		}
	}
</style>
