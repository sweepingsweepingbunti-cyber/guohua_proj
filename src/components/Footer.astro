---
import { SITE } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-inner">
		<div class="footer-brand">
			<strong>{SITE.name}</strong>
			<p class="muted">{SITE.description}</p>
		</div>

		<div class="footer-cols">
			<div>
				<h4>浏览</h4>
				<ul>
					{
						SITE.nav.map((item) => (
							<li>
								<a href={item.href}>{item.label}</a>
							</li>
						))
					}
				</ul>
			</div>
			<div>
				<h4>订阅</h4>
				<ul>
					<li><a href="/rss.xml">RSS</a></li>
					<li><a href="/about">关于本站</a></li>
				</ul>
			</div>
			<div>
				<h4>找到我</h4>
				<ul>
					<li>
						<a href={SITE.social.github} target="_blank" rel="noopener noreferrer">
							GitHub
						</a>
					</li>
					{
						SITE.social.email && (
							<li>
								<a href={`mailto:${SITE.social.email}`}>邮件</a>
							</li>
						)
					}
				</ul>
			</div>
		</div>
	</div>

	<div class="container footer-bottom">
		<p class="dim">© {year} {SITE.name}. 保留所有权利。</p>
		<p class="dim">Powered by Astro · 部署于 Netlify</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 80px;
		border-top: 1px solid var(--border);
		background: var(--bg-soft);
	}

	.footer-inner {
		display: flex;
		justify-content: space-between;
		gap: 48px;
		padding: 44px 24px 32px;
		flex-wrap: wrap;
	}

	.footer-brand {
		max-width: 34ch;
	}

	.footer-brand strong {
		display: block;
		font-size: 1.05rem;
		margin-bottom: 6px;
	}

	.footer-brand p {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.65;
	}

	.footer-cols {
		display: flex;
		gap: 56px;
	}

	.footer-cols h4 {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-dim);
		margin: 0 0 12px;
		font-weight: 600;
	}

	.footer-cols ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.footer-cols a {
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	.footer-cols a:hover {
		color: var(--accent);
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		padding: 18px 24px 28px;
		border-top: 1px solid var(--border);
		flex-wrap: wrap;
	}

	.footer-bottom p {
		margin: 0;
		font-size: 0.8rem;
	}

	@media (max-width: 768px) {
		.site-footer {
			margin-top: 56px;
		}

		.footer-inner {
			padding: 36px 18px 24px;
			gap: 32px;
		}

		.footer-cols {
			gap: 40px;
		}

		.footer-bottom {
			padding: 16px 18px 24px;
		}
	}
</style>
